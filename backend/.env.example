# ==============================================================================
# BidVerify AI Backend - Environment Configuration Template
# ==============================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development

# Database Configuration (PostgreSQL / Supabase with pgvector support)
# Direct connection example:
# DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@db.your-ref.supabase.co:5432/postgres
# Pooler connection example (Session / Transaction mode):
# DATABASE_URL=postgresql+psycopg://postgres.your-ref:YOUR_PASSWORD@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@127.0.0.1:5432/bidverify

# Security & JWT Authentication
# IMPORTANT: Generate a cryptographically secure key for production (e.g. openssl rand -hex 32)
JWT_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Private Document Storage (Supabase Storage / Local Fallback)
# Leave SUPABASE_URL blank to use local filesystem fallback in storage/bid_documents/
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=bid-documents
MAX_FILE_SIZE_BYTES=10485760

# Frontend Integration & CORS Origins
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# AI & RAG Configuration (Part 7E & Document AI)
# Providers: 'local_fallback', 'openai', 'gemini'
LLM_PROVIDER=local_fallback
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_OUTPUT_TOKENS=1500

EMBEDDING_PROVIDER=local_fallback
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
RAG_TOP_K=10
RAG_SIMILARITY_THRESHOLD=0.5

# API Keys (Optional - only required if provider is set to 'openai' or 'gemini')
OPENAI_API_KEY=
GEMINI_API_KEY=
